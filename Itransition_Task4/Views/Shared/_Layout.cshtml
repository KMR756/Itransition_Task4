<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Itransition_Task4</title>

    <!-- Tailwind CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- ASP.NET generated styles -->
    <link rel="stylesheet"
          href="~/Itransition_Task4.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="flex flex-col min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 text-slate-200 antialiased">

    <!-- =========================================
         STATIC HEADER / NAVBAR
         ========================================= -->
    <header class="sticky top-0 z-50 w-full border-b border-white/10 bg-slate-950/80 backdrop-blur-xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                
                <!-- Brand / Logo -->
                <div class="flex items-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 group">
                        
                        <span class="text-lg font-bold text-white tracking-tight">MyApp</span>
                    </a>
                </div>

               

                

            </div>
        </div>
    </header>


    
    <main role="main" class="flex-grow flex flex-col">
        @RenderBody()
    </main>


    <!-- =========================================
         STATIC FOOTER
         ========================================= -->
    <footer >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            
         
                
                

            <!-- Bottom Divider & Copyright -->
            <div class="pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
                <p>© @DateTime.Now.Year YourApp, Inc. All rights reserved.</p>
                <div class="flex items-center gap-6">
                    <a href="#" class="hover:text-slate-400 transition">Twitter</a>
                    <a href="#" class="hover:text-slate-400 transition">GitHub</a>
                    <a href="#" class="hover:text-slate-400 transition">Discord</a>
                </div>
            </div>

        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
